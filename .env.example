# ─── AI KEYS ──────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# ─── FREE SERVICES (no key needed) ────────────────
# JobSpy uses Indeed/LinkedIn scraping — no API key required
# Notion free tier — optional tracker
NOTION_TOKEN=your_notion_token_here         # optional
NOTION_DATABASE_ID=your_database_id_here    # optional

# ─── AGENT CONFIG ─────────────────────────────────
MAX_APPLICATIONS_PER_RUN=10
MIN_MATCH_SCORE=70                          # 0-100, only apply if score >= this
DRY_RUN=true                                # set to false to actually submit apps

# ─── YOUR PROFILE ─────────────────────────────────
CANDIDATE_NAME="Your Full Name"
CANDIDATE_EMAIL="you@email.com"
CANDIDATE_PHONE="+1-555-000-0000"
CANDIDATE_LOCATION="San Francisco, CA"
CANDIDATE_LINKEDIN="https://linkedin.com/in/yourprofile"
CANDIDATE_GITHUB="https://github.com/yourusername"
